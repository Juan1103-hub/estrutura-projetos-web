{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "DEPLOY.md",
    "rules/*.md"
  ],
  "permission": {
    "skill": { "*": "allow" }
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".opencode/node_modules/**",
      "projects/*/node_modules/**",
      "projects/*/.next/**",
      "projects/*/dist/**",
      "projects/*/build/**",
      "projects/*/.vercel/**",
      "projects/*/supabase/.temp/**",
      ".playwright-mcp/**",
      ".specs/projects/*/features/*/tmp/**"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "share": "manual"
}